<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <!-- Compendium framework — pin to a published NuGet version. Update via Renovate.
       These packages ship net9.0 assets only; net10.0 consumes them as such. -->
  <ItemGroup>
    <PackageVersion Include="Compendium.Abstractions" Version="1.0.5-preview.5" />
    <PackageVersion Include="Compendium.Core" Version="1.0.5-preview.5" />
    <PackageVersion Include="Compendium.Infrastructure" Version="1.0.5-preview.5" />
    <PackageVersion Include="Compendium.Multitenancy" Version="1.0.5-preview.5" />
  </ItemGroup>

  <!-- Build-time tooling -->
  <ItemGroup>
    <PackageVersion Include="MinVer" Version="8.0.0" />
  </ItemGroup>

  <!-- Production runtime -->
  <ItemGroup>
    <PackageVersion Include="Dapper" Version="2.1.86" />
    <PackageVersion Include="Npgsql" Version="10.0.3" />
  </ItemGroup>

  <!-- Test stack (matches the framework's testing conventions exactly) -->
  <ItemGroup>
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.0" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageVersion Include="AwesomeAssertions" Version="9.6.0" />
    <PackageVersion Include="NSubstitute" Version="6.2.0" />
    <PackageVersion Include="AutoFixture" Version="4.18.1" />
    <PackageVersion Include="AutoFixture.Xunit2" Version="4.18.1" />
    <PackageVersion Include="Bogus" Version="35.6.1" />
    <PackageVersion Include="coverlet.collector" Version="10.1.0" />
    <PackageVersion Include="RichardSzalay.MockHttp" Version="7.0.0" />
  </ItemGroup>

  <!-- Container fixtures for integration tests. -->
  <ItemGroup>
    <PackageVersion Include="Testcontainers" Version="4.15.0" />
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.15.0" />
  </ItemGroup>

  <!-- NET10-01: one line per target for the Microsoft.Extensions.* family, which
       is versioned with the runtime.

       net9.0 is the 9.0.x set the published package's consumers already run
       against (Compendium 1.0.5-preview.5 asks for >= 9.0.19); it does not move.
       Three of these pins had drifted to 10.0.12 on the single net9.0 target, so
       the net9.0 nuspec was pushing 10.x packages onto .NET 9 consumers; they go
       back to the 9.0.x line here. net10.0 cannot share that line: Npgsql 10.0.3
       asks for Microsoft.Extensions.Logging.Abstractions >= 10.0.0 in its net10.0
       dependency group, and a central 9.0.x pin would be a package downgrade
       (NU1605, an error here). Dependabot updates each line on its own; its
       semver-major ignore (.github/dependabot.yml) keeps the net9.0 line on 9.x.

       Only the five packages a project actually references are pinned. The six
       pins no project referenced (Configuration, Configuration.Abstractions,
       Configuration.Binder, Http, Options.ConfigurationExtensions,
       Options.DataAnnotations) are removed rather than duplicated per target:
       without transitive pinning they had no effect on any graph. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net9.0'">
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="9.0.19" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="9.0.19" />
    <PackageVersion Include="Microsoft.Extensions.Logging" Version="9.0.19" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="9.0.19" />
    <PackageVersion Include="Microsoft.Extensions.Options" Version="9.0.19" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.12" />
    <!-- Referenced by the adapter's net10.0 target only, to settle a transitive
         downgrade (NU1605) explained in its .csproj. -->
    <PackageVersion Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Logging" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Options" Version="10.0.12" />
  </ItemGroup>
</Project>
